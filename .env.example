# Environment Configuration for StudyMind AI

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=studymind
POSTGRES_PASSWORD=studymind_secret
POSTGRES_DB=studymind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://studymind:studymind_secret@localhost:5432/studymind_db

# JWT Security
SECRET_KEY=studymind_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# Options: "gemini", "ollama", "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama Configuration (if using local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings Configuration
# Options: "gemini", "ollama", "sentence-transformers"
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Uploads directory
UPLOAD_DIR=./uploads
