# ==============================================================================
# StudyMind AI - Backend Environment Configuration Template
# ==============================================================================

PROJECT_NAME="StudyMind AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- Database Configuration ---
# Production: PostgreSQL with pgvector (Docker or managed service like Supabase/Neon)
DATABASE_URL="postgresql+asyncpg://studymind:studymind_secret@localhost:5432/studymind_db"
# Fallback to local SQLite for rapid development without Docker
USE_SQLITE_FALLBACK=True

# --- Security & JWT Authentication ---
# IMPORTANT: Generate a cryptographically secure key for production (e.g. openssl rand -hex 32)
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS & Network Origins ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
DISABLE_RATE_LIMIT=False

# --- AI Provider Configuration ---
# Primary LLM Provider: "groq" | "gemini" | "openrouter" | "ollama"
LLM_PROVIDER="groq"

# Groq API Configuration (Fast, Arabic-optimized)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Google Gemini Configuration (High-capacity fallback)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"
